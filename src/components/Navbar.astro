---
/**
 * Barra de navegacion. Conserva las clases exactas de Webflow para que el CSS
 * portado aplique igual.
 *
 * Diferencia con Webflow: alli el menu movil lo abria jQuery, que inyectaba un
 * .w-nav-overlay y estilos en linea. Aqui lo hace un boton nativo con
 * aria-expanded y ~10 lineas de CSS y JS. Se ve y se comporta igual, pero es
 * accesible con teclado (Webflow usaba un div sin rol de boton) y no necesita
 * los 33 KB de jQuery.
 */
import hotel from '../content/hotel.json';
import Foto from './Foto.astro';

const wa = `https://wa.me/${hotel.whatsapp}?text=Hola%2C%20quiero%20reservar%20en%20Hotel%20Quinta%20Azul`;
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
const esActual = (href: string) => actual === href;
---
<div
  data-navbar
  data-animation="default"
  data-collapse="medium"
  role="banner"
  class="navbar6_component color-scheme-3 w-nav"
>
  <div class="navbar6_container">
    <a
      href="/"
      class:list={['navbar6_logo-link', 'w-nav-brand', esActual('/') && 'w--current']}
      aria-current={esActual('/') ? 'page' : undefined}
      aria-label="Hotel Quinta Azul, ir al inicio"
    >
      <Foto archivo="logo-navbar-hotel-quinta-azul.png" alt="Hotel Quinta Azul" width={100} class="navbar6_logo" loading="eager" />
    </a>

    <nav id="menu-principal" role="navigation" class="navbar6_menu w-nav-menu">
      <div class="navbar6_menu-left">
        <a href="/hospedaje" class:list={['navbar6_link', 'w-nav-link', esActual('/hospedaje') && 'w--current']} aria-current={esActual('/hospedaje') ? 'page' : undefined}>Hospedaje</a>
        <a href="/celebraciones" class:list={['navbar6_link', 'w-nav-link', esActual('/celebraciones') && 'w--current']} aria-current={esActual('/celebraciones') ? 'page' : undefined}>Celebraciones</a>
        <a href="/ubicacion" class:list={['navbar6_link', 'w-nav-link', esActual('/ubicacion') && 'w--current']} aria-current={esActual('/ubicacion') ? 'page' : undefined}>Ubicación</a>
      </div>
      <div class="navbar6_menu-right">
        <a href="/contacto" class="button is-secondary is-small w-button">Contacto</a>
        <a href={wa} class="button is-small w-button" rel="noopener">Reservar</a>
      </div>
    </nav>

    <button
      type="button"
      class="navbar6_menu-button w-nav-button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <div class="menu-icon5">
        <div class="menu-icon1_line-top"></div>
        <div class="menu-icon1_line-middle"><div class="menu-icon1_line-middle-inner"></div></div>
        <div class="menu-icon1_line-bottom"></div>
      </div>
    </button>
  </div>
</div>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');
  const boton = navbar?.querySelector<HTMLButtonElement>('.w-nav-button');
  const menu = navbar?.querySelector<HTMLElement>('.w-nav-menu');
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  const enlaces = navbar ? [...navbar.querySelectorAll<HTMLElement>('.w-nav-link')] : [];

  // Las mismas marcas que ponia webflow.js al abrir: con ellas aplica el CSS
  // de Webflow para el menu abierto (enlaces uno debajo de otro, botones a
  // todo el ancho). Sin ellas los enlaces quedaban en una sola linea.
  function marcar(abierto: boolean) {
    menu?.toggleAttribute('data-nav-menu-open', abierto);
    enlaces.forEach((a) => a.classList.toggle('w--nav-link-open', abierto));
  }

  function ocultar() {
    navbar?.removeAttribute('data-abierto');
    navbar?.removeAttribute('data-cerrando');
    marcar(false);
  }
  // Se guarda aparte para poder cancelarlo si se vuelve a abrir el menu
  // mientras todavia esta subiendo.
  function alTerminarDeSubir(e: AnimationEvent) {
    if (e.target !== menu) return;
    menu?.removeEventListener('animationend', alTerminarDeSubir);
    ocultar();
  }

  function cerrar(animado = true) {
    if (!navbar?.hasAttribute('data-abierto') || navbar.hasAttribute('data-cerrando')) return;
    boton?.setAttribute('aria-expanded', 'false');
    boton?.setAttribute('aria-label', 'Abrir menú');
    boton?.classList.remove('w--open');
    if (!animado || sinMovimiento.matches || !menu) return ocultar();
    // Webflow: antes de ocultarse, el menu vuelve a subir en 0.4 s.
    navbar.setAttribute('data-cerrando', '');
    menu.addEventListener('animationend', alTerminarDeSubir);
  }

  function abrir() {
    if (!navbar || !boton) return;
    menu?.removeEventListener('animationend', alTerminarDeSubir);
    navbar.removeAttribute('data-cerrando');
    // El menu baja desde el borde inferior de la barra: necesita su altura.
    navbar.style.setProperty('--alto-nav', `${navbar.offsetHeight}px`);
    marcar(true);
    navbar.setAttribute('data-abierto', '');
    boton.classList.add('w--open');
    boton.setAttribute('aria-expanded', 'true');
    boton.setAttribute('aria-label', 'Cerrar menú');
  }

  boton?.addEventListener('click', () => {
    const abierto = navbar?.hasAttribute('data-abierto') && !navbar.hasAttribute('data-cerrando');
    if (abierto) cerrar();
    else abrir();
  });

  // Escape cierra el menu y devuelve el foco al boton.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navbar?.hasAttribute('data-abierto')) {
      cerrar();
      boton?.focus();
    }
  });

  // Al pasar a escritorio, el menu vuelve a su sitio: limpiamos el estado.
  window.matchMedia('(min-width: 992px)').addEventListener('change', (e) => {
    if (e.matches) cerrar(false);
  });
</script>
